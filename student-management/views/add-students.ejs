
<!DOCTYPE html>
<html>
<head>
    <title>Add Student</title>
</head>
<body>

    <h1>Add New Student</h1>

    <form action="/students" method="POST">

        <label>Student Name:</label>

        <input
            type="text"
            name="name"
            required
        >

        <br><br>

        <label>Course:</label>

        <input
            type="text"
            name="course"
            required
        >

        <br><br>

        <button type="submit">Add Student</button>

    </form>

    <br>

    <a href="/students">Back to Students</a>

</body>
</html>
